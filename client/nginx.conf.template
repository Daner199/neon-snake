# Plantilla: al arrancar, nginx cambia ${PORT} y ${API_URL} por las variables de entorno
# (en Docker local: 80 y http://api:3000; en Railway: el puerto que da Railway y la URL privada de la API).
# WebSocket del multijugador en línea: si el navegador pide "Upgrade", se pasa tal cual a la API
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen ${PORT};
  root /usr/share/nginx/html;
  index index.html;

  # Las llamadas a la API van al servicio de la API
  location /api/ {
    proxy_pass ${API_URL};
    proxy_ssl_server_name on;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Multijugador (Socket.IO en /api/socket.io): WebSocket y conexiones largas
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 1h;
  }

  # Archivos con hash en el nombre: se pueden guardar en caché mucho tiempo
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Vue Router: cualquier ruta (/jugar/arena, /ranking...) carga index.html
  location / {
    try_files $uri $uri/ /index.html;
  }
}
