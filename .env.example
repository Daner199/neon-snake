# Variables de Neon Snake. Copia este archivo como .env (no se sube a GitHub).
# docker compose lee este .env de la raíz; en Railway se ponen en la pestaña "Variables" de cada servicio.

# ---------- API (carpeta server/) ----------

# Conexión a PostgreSQL. En Docker local la arma docker-compose.yml;
# para "npm run dev" usa server/.env (puerto 5433); en Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://snake:snake123@localhost:5433/neon_snake"

# Texto largo y secreto para firmar los tokens de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-texto-largo-y-secreto"

# Dominios que pueden llamar a la API desde otro origen, separados por comas.
# Vacío = ninguno (el juego usa /api por su mismo dominio a través de nginx, no lo necesita).
CORS_ORIGIN=""

# Cuántos proxies hay delante de la API: 1 en Docker local (nginx), 2 en Railway (borde de Railway + nginx)
TRUST_PROXY=1

# Puerto de la API. En Railway ponlo fijo en 3000 para que API_URL lo encuentre.
PORT=3000

# ---------- Web (carpeta client/, nginx) ----------

# Dónde está la API, vista desde el contenedor web. Docker local: http://api:3000
# Railway (red privada): http://${{api.RAILWAY_PRIVATE_DOMAIN}}:3000
API_URL="http://api:3000"

# El puerto de nginx lo pone Railway solo (variable PORT del servicio web). En Docker local es 80.
